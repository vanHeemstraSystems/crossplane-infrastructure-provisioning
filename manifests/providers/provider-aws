---
# AWS Provider for Crossplane v1.15+
# Uses the official Upbound AWS provider family
apiVersion: pkg.crossplane.io/v1
kind: Provider
metadata:
  name: upbound-provider-family-aws
spec:
  package: xpkg.upbound.io/upbound/provider-family-aws:v1.2.0
  packagePullPolicy: IfNotPresent
---
# ProviderConfig for AWS
# Configures authentication for AWS provider family
# NOTE: This references a secret that must be created with AWS credentials
apiVersion: aws.upbound.io/v1beta1
kind: ProviderConfig
metadata:
  name: default
spec:
  credentials:
    source: Secret
    secretRef:
      namespace: crossplane-system
      name: aws-secret
      key: creds

