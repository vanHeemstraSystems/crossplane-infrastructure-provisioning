---
# Azure Provider for Crossplane v1.15+
# Uses the official Upbound Azure provider family
apiVersion: pkg.crossplane.io/v1
kind: Provider
metadata:
  name: upbound-provider-family-azure
spec:
  package: xpkg.upbound.io/upbound/provider-family-azure:v1.2.0
  packagePullPolicy: IfNotPresent
---
# ProviderConfig for Azure
# Configures authentication for Azure provider family
# NOTE: This references a secret that must be created with Azure service principal credentials
apiVersion: azure.upbound.io/v1beta1
kind: ProviderConfig
metadata:
  name: default
spec:
  credentials:
    source: Secret
    secretRef:
      namespace: crossplane-system
      name: azure-secret
      key: creds

